#!/bin/sh
# Pushing main deploys to production (Vercel), so run the full check first:
# typecheck, build, and the headless smoke test (scripts/smoke.mjs).
# Other branches are not checked. Skip once with: git push --no-verify
#
# Enable in a fresh clone with: git config core.hooksPath .githooks

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing main (deploys to production), running npm run check..."
    if ! npm run check; then
      echo "pre-push: check failed, push blocked. Fix it, or skip with --no-verify."
      exit 1
    fi
    exit 0
  fi
done
exit 0
